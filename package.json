{
  "name": "elenchus-root",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "resolutions": {
    "**/@types/*": "latest"
  },
  "scripts": {
    "start:server": "npm run start --workspace=server",
    "dev:server:nodemon": "npm run build:contracts && npm run dev:nodemon --workspace=server",
    "dev:client": "npm run dev --workspace=elenchus",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "build:contracts": "npm run build --workspace=@elenchus/contracts",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=elenchus"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "@tabler/icons-react": "^3.34.1",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/he": "^1.2.1",
    "@types/sanitize-html": "^2.5.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2"
  },
  "workspaces": [
    "packages/contracts",
    "client",
    "server"
  ],
  "overrides": {
    "qs": "6.16.0",
    "axios": "1.20.0"
  }
}
