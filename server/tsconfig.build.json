{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "endpoints/**/*",
    "envConfig/**/*",
    "scripts/**/*",
    "integrations/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
